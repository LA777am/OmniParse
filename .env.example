# ─── Local MongoDB ───
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=omniparse

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── Gemini API (for LLM generation only — embeddings use local sentence-transformers) ───
GEMINI_API_KEY=YOUR_API_KEY_HERE

# ─── File Storage ───
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── Embedding Model ───
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# ─── FastAPI ───
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

